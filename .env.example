# ===== Plant Doctor settings =====
# Only GROQ_API_KEY is required. Leave the rest as they are.
# Never share this file or commit it to GitHub.

# Groq API key: console.groq.com -> API Keys
GROQ_API_KEY=

# Groq model name. If you get "model not found", pick a current name
# from console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# 0 = focused answers, 1 = more creative answers
GROQ_TEMPERATURE=0.3

# Language used for the advice after a scan (for example English, Hindi, Punjabi).
# In the chat, the assistant replies in whatever language the farmer writes in.
REPLY_LANGUAGE=English

# Model files (paths relative to the project folder)
MODEL_PATH=models/plant_model.keras
CLASS_NAMES_PATH=models/class_names.json
IMG_SIZE=224

# Below this confidence the app says it is not sure (value from 0 to 1)
MIN_CONFIDENCE=0.6
